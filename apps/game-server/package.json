{
  "name": "@multiplayer/game-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:colyseus --external:@colyseus/* --external:express --external:livekit-server-sdk --external:better-sqlite3",
    "start": "node dist/index.js",
    "loadtest": "tsx src/loadtest/socialRoomBot.ts --room social_room",
    "typecheck": "tsc --noEmit",
    "lint": "true",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.21",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.5",
    "@multiplayer/shared": "workspace:*",
    "@privy-io/server-auth": "^1.32.5",
    "better-sqlite3": "^13.0.2",
    "colyseus": "^0.16.5",
    "express": "^4.22.2",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@colyseus/loadtest": "0.16.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "colyseus.js": "^0.16.22",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
