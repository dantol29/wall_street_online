{
  "name": "@multiplayer/game-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:colyseus --external:@colyseus/* --external:express --external:livekit-server-sdk",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "true",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.21",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.5",
    "@multiplayer/shared": "workspace:*",
    "colyseus": "^0.16.5",
    "express": "^4.22.2",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
