PORT=2567
NODE_ENV=development
VOICE_ENABLED=true
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: wallet login (see WalletPanel). Leave unset to disable it —
# guests can still join and play normally. Get these from your app's
# settings in the Privy dashboard (https://dashboard.privy.io).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
